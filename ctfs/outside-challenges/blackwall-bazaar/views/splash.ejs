<%- include('partials/head', { title: 'BLACKWALL BAZAAR // sealed' }) %>
<div class="wrap">
  <div class="center" style="margin-top:6vh">
    <h1 class="glitch" data-text="BLACKWALL BAZAAR" style="font-size:2.6rem">BLACKWALL BAZAAR</h1>
    <p class="muted">// you didn't find this place. it found you. //</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="wrap" style="max-width:560px;padding:0"><div class="flash"><%= error %></div></div>
  <% } %>
  <% if (typeof notice !== 'undefined' && notice) { %>
    <div class="wrap" style="max-width:560px;padding:0"><div class="flash warn"><%= notice %></div></div>
  <% } %>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;max-width:820px;margin:24px auto">

    <!-- STEP 1: INVITE GATE -->
    <div class="panel">
      <h3>&gt; INVITE ONLY</h3>
      <p class="dim">Membership is invite-only. No code, no entry. Runners get a code
      out-of-band. They look like this:</p>
      <p class="center"><code class="hot" style="font-size:1.1rem"><%= sampleCode %></code></p>
      <p class="muted" style="font-size:12px">(that one's stale. burned a long time ago. but
      the shape is the shape.)</p>
      <form method="POST" action="/gate">
        <label>INVITE CODE</label>
        <input type="text" name="invite" placeholder="paste your code" autocomplete="off" required autofocus>
        <div style="margin-top:14px"><button class="btn" type="submit">CHECK CODE</button></div>
      </form>
    </div>

    <!-- LOGIN -->
    <div class="panel">
      <h3>&gt; RETURNING RUNNER</h3>
      <p class="dim">Already carved a rig? Slot back in.</p>
      <form method="POST" action="/login">
        <label>HANDLE</label>
        <input type="text" name="handle" autocomplete="off" required>
        <label>PASSPHRASE</label>
        <input type="password" name="password" required>
        <div style="margin-top:14px"><button class="btn cyan" type="submit">JACK IN</button></div>
      </form>
      <hr>
      <p class="muted" style="font-size:12px">&gt; NODE: relay mesh<br>&gt; ICE: online<br>&gt; INTRUSION LOG: enabled</p>
    </div>

  </div>

  <div class="center muted" style="font-size:12px;margin-top:20px">
    <span id="op-online">0</span> operators online // last breach: <span id="last-breach">--</span>
  </div>
</div>

<script>
  // faux "alive" counters on the door
  (function(){
    var o=document.getElementById('op-online'), b=document.getElementById('last-breach');
    function tick(){ o.textContent = 40 + Math.floor(Math.random()*17); }
    function breach(){ b.textContent = (1+Math.floor(Math.random()*9)) + ' min ago'; }
    tick(); breach(); setInterval(tick, 3200); setInterval(breach, 9000);
  })();
</script>
<%- include('partials/foot') %>
